SUPABASE_PROJECT_ID=<your-supabase-project-id>
SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<your-supabase-project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
VITE_SUPABASE_URL=https://<your-supabase-project-id>.supabase.co

# Supabase service role key — server-only, never expose to client
# Get from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Lovable AI Gateway key — required for all AI features (chat, orchestrator, vault, CFO tools)
# Get from: https://lovable.dev/settings or your Lovable Cloud project dashboard
LOVABLE_API_KEY=<your-lovable-api-key>

# ElevenLabs Conversational AI — required for Atlas CFO voice
# Get from: https://elevenlabs.io/app/conversational-ai
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
ELEVENLABS_AGENT_ID=<your-elevenlabs-agent-id>

# Security: set to "true" in production to require ephemeral tokens on CFO tool webhooks
CFO_TOOLS_REQUIRE_EPHEMERAL=true
